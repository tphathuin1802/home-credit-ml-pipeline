# Auto detect text files and perform LF normalization
* text=auto
# NOTE: model/*.joblib + .pkl are committed directly to git (small enough,
# avoids LFS pointer issues on Streamlit Cloud). PNG/JSON/CSV still use LFS.
*.joblib filter= diff= merge= -text
*.pkl filter= diff= merge= -text
model/*.png filter=lfs diff=lfs merge=lfs -text
model/*.json filter=lfs diff=lfs merge=lfs -text
model/*.csv filter=lfs diff=lfs merge=lfs -text
