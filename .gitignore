# Byte-compiled / packaging
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual envs
.venv/
venv/
env/

# IDE
.idea/
.vscode/
*.swp
.DS_Store

# Data - KHONG commit full dataset (rat nang, co ban quyen)
# Cho phep: file sample nho (2.7MB) + .gitkeep de giu folder
data/**
!data/**/.gitkeep
!data/raw/application_train_sample.csv

# Power BI - giữ scripts + theme + docs + screenshots, không commit data
powerbi/data/*.csv

# Notebooks - cache
notebooks/.ipynb_checkpoints/
*.ipynb_checkpoints

# Model artifacts (PNG plots được commit để hiển thị trên cloud)
# NOTE: model.joblib cần lên cloud để app hoạt động — KHÔNG ignore
model/*.pkl

# Test / coverage
.pytest_cache/
.coverage
htmlcov/

# Secrets / env
.env
.env.*
!.env.example

# Kaggle cache
.cache/

# Log files - KHONG commit (log training, khong can lich su)
*.log
!logs/.gitkeep
